<Window x:Class="ShikkhaDesk.Wpf.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:ShikkhaDesk.Wpf.Infrastructure"
        Title="শিক্ষা ডেস্ক — কোচিং সেন্টার ব্যবস্থাপনা"
        Width="1440" Height="900" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app-icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ShikkhaDesk.Wpf;component/Views/PageTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Foreground" Value="#BCCCDC" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1B3550" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1B3550" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryTealBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PrimaryNavyBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/app-icon-64.png" Width="30" Height="30" Margin="0,0,10,0" />
                    <TextBlock x:Name="InstitutionName" Text="শিক্ষা ডেস্ক" Foreground="White"
                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="কোচিং সেন্টারের সম্পূর্ণ ব্যবস্থাপনা, এক জায়গায়।" Foreground="#829AB1"
                               FontSize="11" VerticalAlignment="Center" Margin="14,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentUserName" Foreground="#D9E2EC" VerticalAlignment="Center"
                               FontSize="13" Margin="0,0,14,0" />
                    <Button x:Name="LogoutButton" Content="লগ আউট" Click="Logout_Click"
                            Background="Transparent" Foreground="White" BorderBrush="#486581"
                            MinHeight="30" Padding="14,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PrimaryNavyBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,10,0,20">
                <ItemsControl x:Name="NavHost" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" Foreground="#627D98" FontSize="11"
                                           FontWeight="SemiBold" Margin="14,10,0,4" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NavButton}"
                                                    Content="{Binding Label}"
                                                    Command="{Binding DataContext.NavigateCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl,
                                                        AncestorLevel=2}}"
                                                    CommandParameter="{Binding Key}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" Margin="0" />
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ContentControl Content="{Binding CurrentPage}" />
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SecondaryNavyBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="#9FB3C8" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="VersionText" Foreground="#9FB3C8" FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
