<UserControl x:Class="ShikkhaDesk.Wpf.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0" SelectedDate="{Binding From}" Margin="0,0,10,0" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding To}" Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="হালনাগাদ" Command="{Binding RefreshCommand}" Width="110"
                        Margin="0,0,10,0" />
                <TextBlock Grid.Column="3" Text="{Binding Totals}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="4" Content="CSV" Command="{Binding ExportCommand}" Width="80" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
            <StackPanel>
                <TextBlock Text="নগদ ও ব্যাংক হিসাব" Style="{StaticResource SectionTitle}" />
                <DataGrid ItemsSource="{Binding FinancialAccounts}" MaxHeight="220" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <TextBlock Text="হিসাবের তালিকা (Chart of Accounts)" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Accounts}" MinHeight="340" MaxHeight="620" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
