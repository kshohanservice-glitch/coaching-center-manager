<UserControl x:Class="ShikkhaDesk.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding TodayText}" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding GeneratedText}" Style="{StaticResource MutedText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="রিফ্রেশ" Command="{Binding RefreshCommand}" Width="110" />
        </Grid>

        <TextBlock Text="এক নজরে" Style="{StaticResource SectionTitle}" />

        <ItemsControl ItemsSource="{Binding Metrics}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryNavyBrush}" />
                            <TextBlock Text="{Binding Hint}" Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Background="#FFFDF8EC"
                BorderBrush="{StaticResource AccentBrush}">
            <StackPanel>
                <TextBlock Text="মনে রাখবেন" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" FontSize="12">
                    'মোট বকেয়া' হলো শিক্ষার্থীদের ওপর ধার্যকৃত ফি যা এখনো আদায় হয়নি। 'অগ্রিম ক্রেডিট' হলো
                    এমন টাকা যা পাওয়া গেছে কিন্তু কোনো ফির সাথে এখনো বরাদ্দ হয়নি — এটি আয় নয়, দায়।
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
