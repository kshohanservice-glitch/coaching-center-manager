<UserControl x:Class="ShikkhaDesk.Wpf.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="সরবরাহকারী" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="নাম *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name}" Margin="0,0,0,10" />
                <TextBlock Text="ফোন" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone}" Margin="0,0,0,10" />
                <TextBlock Text="ইমেইল" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email}" Margin="0,0,0,10" />
                <TextBlock Text="ঠিকানা" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address}" Height="60" AcceptsReturn="True"
                         VerticalContentAlignment="Top" Margin="0,0,0,12" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="রিফ্রেশ" Command="{Binding RefreshCommand}" Width="90" Margin="0,0,8,0" />
                    <Button Content="সংরক্ষণ" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}" Width="120" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="সরবরাহকারীর তালিকা" Style="{StaticResource SectionTitle}" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" MinHeight="400" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
