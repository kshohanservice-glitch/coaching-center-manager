<UserControl x:Class="ShikkhaDesk.Wpf.Views.ExamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="পরীক্ষার তালিকা">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Exams}" SelectedItem="{Binding Selected}"
                                  MinHeight="380" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,12,0,0">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Content="ফলাফল প্রকাশ করুন" Command="{Binding PublishCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="নতুন পরীক্ষা" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="নাম *" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ExamName}" Margin="0,0,0,10" />
                            <TextBlock Text="ধরন" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ExamType}" Margin="0,0,0,10" />
                            <TextBlock Text="শিক্ষাবর্ষ *" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Session}"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="ব্যাচ" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch}"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="তারিখ" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding ExamDate}" Margin="0,0,0,12" />

                            <TextBlock Text="বিষয়সমূহ" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding SubjectDrafts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Name}" Margin="0,0,6,0" />
                                            <TextBox Grid.Column="1" Text="{Binding MaximumMarks}" Margin="0,0,6,0" />
                                            <TextBox Grid.Column="2" Text="{Binding PassMarks}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="বিষয় যোগ করুন" Command="{Binding AddSubjectCommand}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="পরীক্ষা তৈরি করুন" Command="{Binding CreateExamCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="নম্বর প্রদান">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ExamSubjects}"
                                  SelectedItem="{Binding SelectedSubject}" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="নম্বর লোড করুন" Command="{Binding LoadMarksCommand}"
                                Width="150" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
                    <DataGrid ItemsSource="{Binding Marks}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" MinHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="কোড" Binding="{Binding Code}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="নাম" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="প্রাপ্ত নম্বর" Binding="{Binding Marks}" Width="140" />
                            <DataGridCheckBoxColumn Header="অনুপস্থিত" Binding="{Binding IsAbsent}" Width="110" />
                            <DataGridTextColumn Header="মন্তব্য" Binding="{Binding Remarks}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="নম্বর সংরক্ষণ" Command="{Binding SaveMarksCommand}"
                            Style="{StaticResource PrimaryButton}" Width="160" />
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="গ্রেড স্কেল">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                    <DataGrid ItemsSource="{Binding GradeScale}" IsReadOnly="False" CanUserAddRows="False"
                              MinHeight="360" />
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="গ্রেড স্কেল সংরক্ষণ" Command="{Binding SaveGradeScaleCommand}"
                            Style="{StaticResource PrimaryButton}" Width="200" />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
