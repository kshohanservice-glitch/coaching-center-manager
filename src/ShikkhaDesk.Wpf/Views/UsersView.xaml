<UserControl x:Class="ShikkhaDesk.Wpf.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="ব্যবহারকারী">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="নতুন ব্যবহারকারী" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="ব্যবহারকারীর নাম *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewUserName}" Margin="0,0,0,10" />
                        <TextBlock Text="পুরো নাম *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewFullName}" Margin="0,0,0,10" />
                        <TextBlock Text="ভূমিকা" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                                  Margin="0,0,0,10" />
                        <TextBlock Text="পাসওয়ার্ড *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewPassword}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="তৈরি করুন" Command="{Binding CreateUserCommand}"
                                Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="সক্রিয়/নিষ্ক্রিয়" Command="{Binding ToggleActiveCommand}"
                                    Width="150" Margin="0,0,8,0" />
                            <Button Content="পাসওয়ার্ড রিসেট" Command="{Binding ResetPasswordCommand}"
                                    Width="160" />
                        </StackPanel>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  MinHeight="380" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="ভূমিকা ও অনুমতি">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ভূমিকা" Style="{StaticResource SectionTitle}" />
                        <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                                 DisplayMemberPath="Name" MinHeight="240" Margin="0,0,0,10" />
                        <TextBlock Text="নতুন ভূমিকার নাম" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewRoleName}" Margin="0,0,0,10" />
                        <Button Content="ভূমিকা তৈরি" Command="{Binding CreateRoleCommand}" Width="150"
                                HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="অনুমতিসমূহ" Style="{StaticResource SectionTitle}" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Permissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}" IsChecked="{Binding IsGranted}"
                                              Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,12,0,0">
                            <Button Content="পুনরায় লোড" Command="{Binding LoadPermissionsCommand}"
                                    Width="130" Margin="0,0,8,0" />
                            <Button Content="অনুমতি সংরক্ষণ" Command="{Binding SavePermissionsCommand}"
                                    Style="{StaticResource PrimaryButton}" Width="170" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
