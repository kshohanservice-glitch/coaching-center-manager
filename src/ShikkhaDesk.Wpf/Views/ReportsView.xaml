<UserControl x:Class="ShikkhaDesk.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ShikkhaDesk.Wpf.Infrastructure">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" SelectedIndex="{Binding ReportIndex}" Margin="0,0,10,0">
                    <ComboBoxItem Content="শিক্ষার্থী তালিকা" />
                    <ComboBoxItem Content="বকেয়া প্রতিবেদন" />
                    <ComboBoxItem Content="আদায় খতিয়ান" />
                    <ComboBoxItem Content="আয়ের প্রতিবেদন" />
                    <ComboBoxItem Content="ব্যয়ের প্রতিবেদন" />
                </ComboBox>
                <DatePicker Grid.Column="1" SelectedDate="{Binding From}" Margin="0,0,10,0" />
                <DatePicker Grid.Column="2" SelectedDate="{Binding To}" Margin="0,0,10,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch}"
                          Margin="0,0,10,0" />
                <Button Grid.Column="4" Content="তৈরি করুন" Command="{Binding GenerateCommand}" Width="110"
                        Margin="0,0,10,0" />
                <TextBlock Grid.Column="5" Text="{Binding Summary}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="6" Content="CSV" Command="{Binding ExportCommand}" Width="80"
                        Margin="0,0,10,0" />
                <Button Grid.Column="7" Content="প্রিন্ট" Command="{Binding PrintCommand}" Width="90" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" MinHeight="420" MaxHeight="640"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          infra:DictionaryGrid.Columns="{Binding Headers}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
