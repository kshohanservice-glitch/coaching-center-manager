<UserControl x:Class="ShikkhaDesk.Wpf.Views.CashbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}"
                          Margin="0,0,10,0" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding From}" Margin="0,0,10,0" />
                <DatePicker Grid.Column="2" SelectedDate="{Binding To}" Margin="0,0,10,0" />
                <Button Grid.Column="3" Content="হালনাগাদ" Command="{Binding RefreshCommand}" Width="120"
                        Margin="0,0,10,0" />
                <TextBlock Grid.Column="4" Text="{Binding Totals}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" MinHeight="420" MaxHeight="640" />
                <Button Grid.Row="2" Content="CSV রপ্তানি" Command="{Binding ExportCommand}" Width="130"
                        HorizontalAlignment="Right" Margin="0,12,0,0" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
