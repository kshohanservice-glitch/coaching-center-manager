<UserControl x:Class="ShikkhaDesk.Wpf.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="বেতন" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="মাস (YYYY-MM)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PeriodKey}" Margin="0,0,0,10" />

                    <TextBlock Text="পরিশোধের তারিখ" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding PaymentDate}" Margin="0,0,0,10" />

                    <TextBlock Text="পদ্ধতি" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedIndex="{Binding MethodIndex}" Margin="0,0,0,10">
                        <ComboBoxItem Content="নগদ" />
                        <ComboBoxItem Content="ব্যাংক" />
                        <ComboBoxItem Content="মোবাইল ব্যাংকিং" />
                    </ComboBox>

                    <TextBlock Text="হিসাব *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="বেতন তৈরি করুন" Command="{Binding AccrueCommand}" Width="150"
                                Margin="0,0,8,8" />
                        <Button Content="লোড করুন" Command="{Binding LoadCommand}" Width="100"
                                Margin="0,0,8,8" />
                        <Button Content="CSV" Command="{Binding ExportCommand}" Width="80" Margin="0,0,8,8" />
                        <Button Content="বেতন পরিশোধ" Command="{Binding PayCommand}"
                                Style="{StaticResource PrimaryButton}" Width="150" Margin="0,0,0,8" />
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Background="#FFFDF8EC"
                            BorderBrush="{StaticResource AccentBrush}">
                        <TextBlock Text="প্রথমে মাস দিয়ে 'বেতন তৈরি করুন' চাপুন — এতে ব্যয় স্বীকৃত হয় ও দায় তৈরি হয়।
এরপর তালিকা থেকে কর্মচারী নির্বাচন করে 'বেতন পরিশোধ' করলে দায় কমে, কিন্তু ব্যয় দ্বিতীয়বার কাটা হয় না।"
                                   TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding TotalText}" FontWeight="SemiBold" Margin="0,0,0,10"
                           TextWrapping="Wrap" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                          MinHeight="420" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
