<UserControl x:Class="ShikkhaDesk.Wpf.Views.AdmissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="শিক্ষার্থীর তথ্য" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="পুরো নাম *" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="অভিভাবকের নাম" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding GuardianName}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="অভিভাবকের ফোন" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding GuardianPhone}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="শিক্ষার্থীর ফোন" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StudentPhone}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="লিঙ্গ" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Gender}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="জন্ম তারিখ" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding DateOfBirth}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="স্কুল / কলেজ" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SchoolOrCollege}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="ঠিকানা" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Address}" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="শ্রেণি" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SchoolClass}" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="ভর্তির তারিখ" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding AdmissionDate}" />
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="মন্তব্য" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Notes}" Height="60" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ভর্তির বিবরণ" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="শিক্ষাবর্ষ *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Session}" Margin="0,0,0,10" />

                    <TextBlock Text="ব্যাচ" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch}" Margin="0,0,0,10" />

                    <TextBlock Text="কোর্স" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding Course}" Margin="0,0,0,10" />

                    <TextBlock Text="ক্লাস / শ্রেণি" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ClassGrades}" SelectedItem="{Binding ClassGrade}"
                              Margin="0,0,0,10" />

                    <TextBlock Text="ফি প্ল্যান" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FeePlans}" SelectedItem="{Binding FeePlan}" Margin="0,0,0,10" />

                    <TextBlock Text="ভর্তি ফি (টাকা)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AdmissionFeeText}" Margin="0,0,0,14" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="পরিষ্কার" Command="{Binding ClearCommand}" Width="90" Margin="0,0,8,0" />
                <Button Content="ভর্তি করুন" Command="{Binding AdmitCommand}"
                        Style="{StaticResource PrimaryButton}" Width="130" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Background="#FFF1FBF7"
                    BorderBrush="{StaticResource PrimaryTealBrush}">
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="13" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
