<Window x:Class="ShikkhaDesk.Wpf.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="শিক্ষা ডেস্ক — প্রথমবারের সেটআপ"
        Width="720" Height="640" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app-icon.ico"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="StepTitle" Text="স্বাগতম" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryNavyBrush}" />
            <TextBlock x:Name="StepHint" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22">
            <Grid>
                <!-- Step 1: welcome -->
                <StackPanel x:Name="StepWelcome">
                    <Image Source="pack://application:,,,/logo.png" Width="96" Height="96"
                           HorizontalAlignment="Left" Margin="0,0,0,14" />
                    <TextBlock Text="শিক্ষা ডেস্ক" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="কোচিং সেন্টারের সম্পূর্ণ ব্যবস্থাপনা, এক জায়গায়।"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        এই সেটআপ একবারই চলবে। এখানে প্রতিষ্ঠানের নাম, প্রথম অ্যাডমিন ব্যবহারকারী,
                        চলতি শিক্ষাবর্ষ এবং হিসাবের সূচনাকালীন নগদ স্থিতি নেওয়া হবে।
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                        পরে যা কিছু দরকার হবে, তা 'প্রতিষ্ঠান প্রোফাইল' ও 'সাধারণ সেটিংস' পৃষ্ঠা থেকে
                        পরিবর্তন করা যাবে। ইন্টারনেট ছাড়াই সবকিছু চলবে।
                    </TextBlock>
                </StackPanel>

                <!-- Step 2: institution -->
                <ScrollViewer x:Name="StepInstitution" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="প্রতিষ্ঠান" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="প্রতিষ্ঠানের নাম (বাংলা) *" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="NameBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="ইংরেজি নাম (ঐচ্ছিক)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="NameEnBox" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <TextBlock Text="ঠিকানা" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AddressBox" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="ফোন" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PhoneBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="ইমেইল" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="EmailBox" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="রশিদ প্রিফিক্স" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReceiptPrefixBox" Text="SD" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="সংখ্যা প্রদর্শন" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DigitBox" SelectedIndex="0">
                                    <ComboBoxItem Content="বাংলা সংখ্যা" Tag="Bengali" />
                                    <ComboBoxItem Content="ইংরেজি সংখ্যা" Tag="English" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Step 3: session + opening balance -->
                <ScrollViewer x:Name="StepSession" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="শিক্ষাবর্ষ ও সূচনাকালীন স্থিতি" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,14">
                            সূচনাকালীন নগদ স্থিতি হলো আজকের দিনের শুরুতে হাতে থাকা নগদ টাকা।
                            এটি সরাসরি নগদ হিসাবে জমা হবে এবং 'মূলধন হিসাবে' (Opening Capital) ক্রেডিট হবে,
                            যাতে আর্থিক অবস্থার হিসাব শুরু থেকেই মেলে। পরে পরিবর্তন করা যাবে না।
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="শিক্ষাবর্ষের নাম *" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SessionNameBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="মুদ্রা প্রতীক" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CurrencyBox" Text="৳" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="শুরু *" Style="{StaticResource FieldLabel}" />
                                <DatePicker x:Name="SessionStartPicker" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="শেষ *" Style="{StaticResource FieldLabel}" />
                                <DatePicker x:Name="SessionEndPicker" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <TextBlock Text="সূচনাকালীন নগদ স্থিতি (টাকা)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="OpeningCashBox" Text="0" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <TextBlock Text="ব্যাকআপ সংরক্ষণের স্থান (ঐচ্ছিক)" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupBox" />
                                    <Button Grid.Column="1" Content="ব্রাউজ" Margin="8,0,0,0"
                                            Click="BrowseBackup_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Step 4: administrator -->
                <ScrollViewer x:Name="StepAdmin" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="অ্যাডমিন ব্যবহারকারী" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,14">
                            এই ব্যবহারকারীর সব অনুমতি থাকবে। পাসওয়ার্ড কমপক্ষে ৮ অক্ষরের হতে হবে এবং
                            তাতে বড় ও ছোট হাতের অক্ষর এবং অঙ্ক থাকতে হবে।
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="ব্যবহারকারীর নাম *" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AdminUserBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="পুরো নাম *" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AdminNameBox" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="পাসওয়ার্ড *" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="AdminPasswordBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="পাসওয়ার্ড নিশ্চিত করুন *" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="AdminConfirmBox" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="PasswordStrengthText"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Step 5: network mode -->
                <ScrollViewer x:Name="StepNetwork" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="নেটওয়ার্ক মোড" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14">
                            একটি কম্পিউটার 'হোস্ট' হিসেবে ডেটাবেস শেয়ার করবে এবং অন্য কম্পিউটারগুলো
                            ল্যান-এর মাধ্যমে তাতে যুক্ত হবে।
                        </TextBlock>

                        <RadioButton x:Name="ModeSingle" Content="একক কম্পিউটার (হোস্ট)" IsChecked="True"
                                     Margin="0,0,0,8" />
                        <TextBlock Text="এই কম্পিউটারেই সব ডেটা থাকবে। একই সময়ে শুধু এখান থেকে কাজ করা হলে এটি বেছে নিন।"
                                   Style="{StaticResource MutedText}" Margin="22,0,0,12" TextWrapping="Wrap" />

                        <RadioButton x:Name="ModeLanHost" Content="ল্যান হোস্ট (অন্যদের সংযোগ দেবে)" Margin="0,0,0,8" />
                        <TextBlock Text="এই কম্পিউটার ডেটাবেস শেয়ার করবে। কম্পিউটারটির একটি স্থির আইপি ঠিকানা থাকতে হবে।"
                                   Style="{StaticResource MutedText}" Margin="22,0,0,12" TextWrapping="Wrap" />

                        <RadioButton x:Name="ModeLanClient" Content="ল্যান ক্লায়েন্ট (হোস্টে যুক্ত হবে)" Margin="0,0,0,8" />
                        <Grid Margin="22,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="হোস্টের আইপি ঠিকানা" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HostAddressBox" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="পোর্ট" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HostPortBox" Text="8787" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Step 6: finish -->
                <ScrollViewer x:Name="StepFinish" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="সব প্রস্তুত" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
                            নিচে দেওয়া তথ্য দিয়ে শিক্ষা ডেস্ক চালু হবে। 'সম্পন্ন করুন'-এ ক্লিক করলে
                            ডেটাবেস তৈরি হয়ে অ্যাডমিন দিয়ে লগ ইন করতে পারবেন।
                        </TextBlock>
                        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13"
                                   Background="{StaticResource AppBackgroundBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="পেছনে" Width="100" Margin="0,0,10,0"
                        Click="Back_Click" />
                <Button x:Name="NextButton" Content="পরবর্তী" Width="110"
                        Style="{StaticResource PrimaryButton}" Click="Next_Click" />
                <Button x:Name="FinishButton" Content="সম্পন্ন করুন" Width="140"
                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="Finish_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
