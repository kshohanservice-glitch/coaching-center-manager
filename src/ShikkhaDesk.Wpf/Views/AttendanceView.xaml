<UserControl x:Class="ShikkhaDesk.Wpf.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch}"
                          Margin="0,0,10,0" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding Date}" Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="লোড করুন" Command="{Binding LoadCommand}" Width="110"
                        Margin="0,0,10,0" />
                <TextBlock Grid.Column="3" Text="{Binding Summary}" VerticalAlignment="Center"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <Button Grid.Column="4" Content="সবাই উপস্থিত" Command="{Binding MarkAllPresentCommand}"
                        Width="130" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <!-- AutoGenerateColumns is off here because the status column must be an editor. -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          IsReadOnly="False" CanUserAddRows="False" MinHeight="380" MaxHeight="620">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="কোড" Binding="{Binding Code}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="নাম" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                        <DataGridComboBoxColumn Header="অবস্থা" SelectedItemBinding="{Binding StatusLabel}"
                                                Width="180">
                            <DataGridComboBoxColumn.ItemsSource>
                                <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>উপস্থিত</sys:String>
                                    <sys:String>অনুপস্থিত</sys:String>
                                    <sys:String>দেরি</sys:String>
                                    <sys:String>ছুটি</sys:String>
                                </x:Array>
                            </DataGridComboBoxColumn.ItemsSource>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="মন্তব্য" Binding="{Binding Note}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="উপস্থিতি সংরক্ষণ" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}" Width="180" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
