<Window x:Class="ShikkhaDesk.Wpf.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="শিক্ষা ডেস্ক" Width="460" Height="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Icon="pack://application:,,,/app-icon.ico"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ValueBox" AcceptsReturn="True" VerticalContentAlignment="Top" Height="80"
                         TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="বাতিল" Width="90" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="ঠিক আছে" Width="110" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
