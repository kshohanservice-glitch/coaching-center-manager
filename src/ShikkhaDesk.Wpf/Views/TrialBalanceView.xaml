<UserControl x:Class="ShikkhaDesk.Wpf.Views.TrialBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" SelectedDate="{Binding From}" Margin="0,0,10,0" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding To}" Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="তৈরি করুন" Command="{Binding RefreshCommand}" Width="120"
                        Margin="0,0,10,0" />
                <TextBlock Grid.Column="3" Text="{Binding Totals}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="4" Content="CSV রপ্তানি" Command="{Binding ExportCommand}" Width="130" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <DataGrid ItemsSource="{Binding Rows}" MinHeight="440" MaxHeight="680" />
        </Border>
    </StackPanel>
</UserControl>
