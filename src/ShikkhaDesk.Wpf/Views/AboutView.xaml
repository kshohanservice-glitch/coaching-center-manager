<UserControl x:Class="ShikkhaDesk.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Image Source="pack://application:,,,/logo.png" Width="80" Height="80"
                       HorizontalAlignment="Left" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Version}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryNavyBrush}" Margin="0,0,0,4" />
                <TextBlock Text="কোচিং সেন্টারের সম্পূর্ণ ব্যবস্থাপনা, এক জায়গায়।"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14" />
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="13" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="সহায়তা" Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    ডকুমেন্টেশন: docs/ ইনস্টলেশন ফোল্ডারে থাকে (docs/USER-GUIDE.md, docs/BACKUP-RESTORE.md,
                    docs/LAN-SETUP.md, docs/SECURITY.md, docs/RELEASE-NOTES.md)। বাংলা চালানোর জন্য Windows-এ
                    বাংলা কীবোর্ড লেআউট যোগ করুন; ইংরেজি কীবোর্ডেও অ্যাপটি পুরোপুরি কাজ করে।
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
