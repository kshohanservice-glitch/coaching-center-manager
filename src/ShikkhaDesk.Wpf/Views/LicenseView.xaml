<UserControl x:Class="ShikkhaDesk.Wpf.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="লাইসেন্স" Style="{StaticResource SectionTitle}" />
                    <Border Background="{StaticResource AppBackgroundBrush}" Padding="12" CornerRadius="6"
                            Margin="0,0,0,14">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" />
                    </Border>

                    <TextBlock Text="লাইসেন্স কী" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding LicenseKey}" Height="110" AcceptsReturn="True"
                             VerticalContentAlignment="Top" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <WrapPanel>
                        <Button Content="লাইসেন্স সক্রিয় করুন" Command="{Binding ActivateCommand}"
                                Style="{StaticResource PrimaryButton}" Width="190" Margin="0,0,8,8" />
                        <Button Content="রিফ্রেশ" Command="{Binding RefreshCommand}" Width="100" Margin="0,0,8,8" />
                        <Button Content="ডিভাইস নিবন্ধন" Command="{Binding RegisterDeviceCommand}"
                                Width="160" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Background="#FFFDF8EC"
                            BorderBrush="{StaticResource AccentBrush}">
                        <TextBlock Text="লাইসেন্স যাচাই সম্পূর্ণরূপে অফলাইনে হয় — ইন্টারনেট ব্যবহার করা হয় না।
মেয়াদ শেষ হলেও আপনার তথ্য লক হয় না; নতুন করে লাইসেন্স না নেওয়া পর্যন্ত শুধু নির্দিষ্ট কাজ বন্ধ থাকে।"
                                   TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="নিবন্ধিত ডিভাইস" Style="{StaticResource SectionTitle}" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          MinHeight="380" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="ডিভাইস সরান" Command="{Binding RevokeDeviceCommand}" Width="140"
                            Margin="0,0,8,0" />
                    <Button Content="এই ডিভাইস দিয়ে বদলান" Command="{Binding ReplaceDeviceCommand}"
                            Style="{StaticResource PrimaryButton}" Width="200" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
