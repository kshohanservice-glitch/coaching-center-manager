<UserControl x:Class="ShikkhaDesk.Wpf.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Search}" Margin="0,0,10,0" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding From}" Margin="0,0,10,0" />
                <DatePicker Grid.Column="2" SelectedDate="{Binding To}" Margin="0,0,10,0" />
                <Button Grid.Column="3" Content="খুঁজুন" Command="{Binding SearchCommand}" Width="110"
                        Margin="0,0,10,0" />
                <TextBlock Grid.Column="4" Text="{Binding TotalText}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="5" Content="CSV রপ্তানি" Command="{Binding ExportCommand}" Width="130" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <DataGrid ItemsSource="{Binding Rows}" MinHeight="420" MaxHeight="660" />
        </Border>
    </StackPanel>
</UserControl>
