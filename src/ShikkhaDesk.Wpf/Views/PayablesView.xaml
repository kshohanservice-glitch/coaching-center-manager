<UserControl x:Class="ShikkhaDesk.Wpf.Views.PayablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="প্রদেয় পরিশোধ" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="পরিমাণ *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AmountText}" Margin="0,0,0,10" />

                    <TextBlock Text="পরিশোধের তারিখ" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding SettlementDate}" Margin="0,0,0,10" />

                    <TextBlock Text="পদ্ধতি" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedIndex="{Binding MethodIndex}" Margin="0,0,0,10">
                        <ComboBoxItem Content="নগদ" />
                        <ComboBoxItem Content="ব্যাংক" />
                        <ComboBoxItem Content="মোবাইল ব্যাংকিং" />
                    </ComboBox>

                    <TextBlock Text="হিসাব *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}"
                              Margin="0,0,0,10" />

                    <TextBlock Text="রেফারেন্স" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Reference}" Margin="0,0,0,10" />

                    <TextBlock Text="অবস্থা ফিল্টার" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedIndex="{Binding StatusIndex}" Margin="0,0,0,12">
                        <ComboBoxItem Content="সব" />
                        <ComboBoxItem Content="খোলা" />
                        <ComboBoxItem Content="আংশিক" />
                        <ComboBoxItem Content="পরিশোধিত" />
                    </ComboBox>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="রিফ্রেশ" Command="{Binding RefreshCommand}" Width="90" Margin="0,0,8,0" />
                        <Button Content="CSV" Command="{Binding ExportCommand}" Width="80" Margin="0,0,8,0" />
                        <Button Content="পরিশোধ করুন" Command="{Binding SettleCommand}"
                                Style="{StaticResource PrimaryButton}" Width="150" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding TotalText}" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                          MinHeight="420" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
