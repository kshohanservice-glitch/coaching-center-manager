<UserControl x:Class="ShikkhaDesk.Wpf.Views.ErrorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource ErrorBrush}" MaxWidth="720"
            HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="এই পৃষ্ঠাটি খোলা যায়নি" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Page}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12">
                বিস্তারিত লগ: %LOCALAPPDATA%\ShikkhaDesk\Logs
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
