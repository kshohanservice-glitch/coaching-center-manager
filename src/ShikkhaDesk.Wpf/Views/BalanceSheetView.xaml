<UserControl x:Class="ShikkhaDesk.Wpf.Views.BalanceSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" SelectedDate="{Binding AsOf}" Margin="0,0,10,0" />
                <Button Grid.Column="1" Content="তৈরি করুন" Command="{Binding RefreshCommand}" Width="120"
                        Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button Grid.Column="3" Content="CSV" Command="{Binding ExportCommand}" Width="90"
                        Margin="0,0,10,0" />
                <Button Grid.Column="4" Content="প্রিন্ট" Command="{Binding PrintCommand}"
                        Style="{StaticResource PrimaryButton}" Width="110" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <DataGrid ItemsSource="{Binding Rows}" MinHeight="420" MaxHeight="640" />
        </Border>
    </StackPanel>
</UserControl>
