<Window x:Class="ShikkhaDesk.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="শিক্ষা ডেস্ক — লগ ইন"
        Width="430" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Icon="pack://application:,,,/app-icon.ico"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,22">
            <Image Source="pack://application:,,,/logo.png" Width="88" Height="88" />
            <TextBlock Text="শিক্ষা ডেস্ক" FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryNavyBrush}" HorizontalAlignment="Center"
                       Margin="0,10,0,2" />
            <TextBlock Text="কোচিং সেন্টারের সম্পূর্ণ ব্যবস্থাপনা, এক জায়গায়।"
                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="ব্যবহারকারীর নাম" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UserTextBox" TabIndex="0" />
                </StackPanel>

                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="পাসওয়ার্ড" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordBox" TabIndex="1" />
                </StackPanel>

                <TextBlock x:Name="MessageText" Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6" MinHeight="18" />

                <Button x:Name="LoginButton" Content="লগ ইন" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" TabIndex="2" Click="Login_Click" Margin="0,4,0,0" Height="38" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="পাসওয়ার্ড ভুলে গেছেন?" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Hyperlink Click="ForgotPassword_Click">প্রশাসকের সাহায্য নিন</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="DeviceText" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                       Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</Window>
