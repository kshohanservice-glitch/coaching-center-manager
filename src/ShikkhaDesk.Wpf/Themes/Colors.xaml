<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ShikkhaDesk brand palette. Values are fixed by docs/BRAND-GUIDELINES.md. -->
    <Color x:Key="PrimaryNavy">#FF102A43</Color>
    <Color x:Key="SecondaryNavy">#FF243B53</Color>
    <Color x:Key="PrimaryTeal">#FF25C2A0</Color>
    <Color x:Key="DarkTeal">#FF138A72</Color>
    <Color x:Key="AppBackground">#FFF5F7FA</Color>
    <Color x:Key="Surface">#FFFFFFFF</Color>
    <Color x:Key="MainText">#FF172B4D</Color>
    <Color x:Key="SecondaryText">#FF627D98</Color>
    <Color x:Key="Border">#FFD9E2EC</Color>
    <Color x:Key="Success">#FF16803C</Color>
    <Color x:Key="Warning">#FFB7791F</Color>
    <Color x:Key="Error">#FFC53030</Color>
    <Color x:Key="Accent">#FFFFB547</Color>

    <SolidColorBrush x:Key="PrimaryNavyBrush" Color="{StaticResource PrimaryNavy}" />
    <SolidColorBrush x:Key="SecondaryNavyBrush" Color="{StaticResource SecondaryNavy}" />
    <SolidColorBrush x:Key="PrimaryTealBrush" Color="{StaticResource PrimaryTeal}" />
    <SolidColorBrush x:Key="DarkTealBrush" Color="{StaticResource DarkTeal}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="MainTextBrush" Color="{StaticResource MainText}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />

    <!-- Bengali-first typography. Nirmala UI ships with Windows 10 and 11 and shapes Bengali
         correctly; the stack falls back to other Bengali-capable faces if it is unavailable. -->
    <FontFamily x:Key="AppFont">Nirmala UI, Vrinda, Kalpurush, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="NumericFont">Nirmala UI, Segoe UI, Consolas</FontFamily>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="PageTitleSize">22</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SectionTitleSize">15</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodySize">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SmallSize">12</sys:Double>
</ResourceDictionary>
